# CarSwipe environment. Copy to .env.local. Every paid key is optional: leave
# it blank and the app falls back (fixtures, template briefs, dev_outbox email,
# hidden push).

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=CarSwipe
LAUNCH_MARKET_ZIP=37203
# Show one-tap demo accounts on /login (local only; never in production).
NEXT_PUBLIC_DEMO_LOGIN=true
# Register the service worker during `next dev` (it always registers in production).
NEXT_PUBLIC_SW_IN_DEV=false
# Secondary sign-in providers (configure them in Supabase Auth first).
NEXT_PUBLIC_AUTH_GOOGLE=false
NEXT_PUBLIC_AUTH_APPLE=false

# Supabase (values printed by `npx supabase start` / `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_PROJECT_REF=

# AI (Claude). Without a key: form-style onboarding extraction and template briefs.
ANTHROPIC_API_KEY=
AI_MODEL_FRONTIER=claude-opus-5
AI_MODEL_FAST=claude-haiku-4-5
EMBEDDINGS_API_KEY=
# Optional override (USD); otherwise app_config.ai.daily_budget_usd_per_user.
AI_DAILY_BUDGET_PER_USER=

# Inventory. "fixtures" uses the 300 seeded cars; add "marketcheck" once licensed.
INVENTORY_SOURCES=fixtures
MARKETCHECK_API_KEY=
MARKETCHECK_API_BASE=https://mc-api.marketcheck.com/v2
MARKETCHECK_MAX_RPS=5
MARKETCHECK_MONTHLY_CALL_BUDGET=
NHTSA_VPIC_BASE=https://vpic.nhtsa.dot.gov/api/vehicles
NHTSA_API_BASE=https://api.nhtsa.gov

# Email (Resend). Without a key, emails land in the dev_outbox table (Admin > Outbox).
RESEND_API_KEY=
EMAIL_FROM="CarSwipe <hello@example.com>"
LEADS_FROM="CarSwipe Leads <leads@example.com>"
RELAY_EMAIL_DOMAIN=relay.example.com
RESEND_WEBHOOK_SECRET=

# Push (Web Push / VAPID). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.com

# Twilio Verify (private-seller and dealership phone checks). Without it,
# codes go to dev_outbox (Admin > Outbox), which is allowed outside production
# or when PHONE_DEV_CODES=true (e.g. a preview deployment).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
PHONE_DEV_CODES=

# Stripe (Phase 2). Without a key, dealers get a "dev entitlement": insights
# and promotions unlock and matched-lead charges stay unbilled.
# Create: a Billing Meter with event name STRIPE_METER_EVENT, a metered price
# on it (per matched lead), a monthly price for insights, a one-time price for
# a promotion. Webhook endpoint: /api/webhooks/stripe (checkout.session.completed,
# customer.subscription.*, invoice.payment_failed).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MATCHED_LEAD=
STRIPE_PRICE_INSIGHTS=
STRIPE_PRICE_PROMOTION=
STRIPE_METER_EVENT=matched_lead

# Finance and insurance partners (Phase 3): "demo" (labeled sample results) or
# "none". Real partner adapters go in src/lib/server/partners.ts. [VERIFY partners]
FINANCE_PARTNER=demo
INSURANCE_PARTNER=demo

# Ops
CRON_SECRET=
ADMIN_BOOTSTRAP_EMAILS=
# Sentry error monitoring (off when blank). Source maps upload only with an auth token.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Tests
E2E_BASE_URL=http://localhost:3000
E2E_MAILPIT_URL=http://127.0.0.1:54324
# Performance test (npm run perf:seed && npm run perf:deck)
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
PERF_RUNS=40
PERF_P95_MS=150
